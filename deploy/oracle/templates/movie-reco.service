[Unit]
Description=Movie Recommendation System (gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Movie-Recommendation-System-master
EnvironmentFile=/etc/movie-reco.env
ExecStart=/home/ubuntu/Movie-Recommendation-System-master/venv/bin/gunicorn movie_recommendation.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 180 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

